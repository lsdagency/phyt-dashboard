# ─────────────────────────────────────────────────────────────
# PHYT ASA Dashboard — environment variables
# Copy to .env.local for local dev; set the same keys in Netlify for production.
# The app runs with SAMPLE DATA when integration keys are absent, so you can
# build and click through everything before wiring real credentials.
# ─────────────────────────────────────────────────────────────

# --- App / branding ---
APP_NAME="PHYT"
CLIENT_NAME="PHYT"
APP_TIMEZONE="Europe/London"        # used to anchor "yesterday" + the daily send

# NOTE: Every integration key below can also be entered in the dashboard UI
# (Settings → Integrations & API keys). A key saved there is encrypted and
# overrides the matching env var, so these are optional once the app is deployed.

# --- Auth (Step 2) ---
JWT_SECRET="change-me-to-a-long-random-string"
# Encrypts API keys saved via the Settings UI. Set a strong value in production.
CREDENTIALS_SECRET="change-me-to-a-long-random-string"
ADMIN_EMAIL="you@lsdagency.com"     # media buyer (full access, sees AI recommendations)
ADMIN_PASSWORD="set-a-strong-password"
CLIENT_EMAIL="team@phytapp.com"     # client login (view-only) + daily report recipient
CLIENT_PASSWORD="set-a-strong-password"

# --- Database: Neon Postgres (Step 2) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Apple Search Ads API (Step 3) ---
ASA_CLIENT_ID=""
ASA_TEAM_ID=""
ASA_KEY_ID=""
ASA_ORG_ID=""
ASA_PRIVATE_KEY=""                  # contents of the .p8 file (PEM), newlines as \n

# --- RevenueCat API v2 (Step 3) ---
REVENUECAT_API_KEY=""               # v2 secret key (sk_...)
REVENUECAT_PROJECT_ID=""

# --- PostHog (Step 3) ---
POSTHOG_API_KEY=""                  # personal API key (phx_...)
POSTHOG_PROJECT_ID=""
POSTHOG_HOST="https://us.posthog.com"   # or https://eu.posthog.com

# --- Claude (Step 4 — daily AI optimisations + email summary) ---
ANTHROPIC_API_KEY=""

# --- Email: Resend (Step 7) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="reports@phytapp.com"

# --- Cron protection (Step 7) ---
CRON_SECRET="change-me-to-a-long-random-string"
